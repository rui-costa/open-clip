# Copy to .env to change how `docker compose up` runs the stack.
# Every value here has a working default; the file is only needed to override one.

# Host ports the two services are published on.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# The API address baked into the frontend bundle at build time. The browser is
# what calls it, so it must be reachable from the host, not from the container.
# Change it only when the backend is published somewhere other than
# http://localhost:${BACKEND_PORT}.
# VITE_API_URL=http://localhost:8000

# The uid/gid the backend container runs as. It writes to ./projects and
# ./backend/config, so it has to own them. Ignored on macOS and Windows, where
# Docker Desktop remaps ownership. On a Linux host or CI runner whose checkout
# is not owned by uid 1000, set these to `id -u` and `id -g` and rebuild.
# APP_UID=1000
# APP_GID=1000

# Where torch and torchvision are installed from. The default is CPU-only.
# For an NVIDIA host, point it at a CUDA build and add a `deploy.resources`
# GPU reservation to the backend service.
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

# The Gemini API key and YouTube client secrets are NOT set here — they are
# entered on the app's Settings page and stored in backend/config/secrets.json,
# which is bind-mounted into the container.
